#!/usr/bin/env bash
# Claude Code PreToolUse hook: keeps an agent from editing the gate's files
# or skipping the pre-commit hook. Reads the tool call as JSON on stdin.
set -euo pipefail

input="$(cat)"
tool="$(jq -r '.tool_name // ""' <<<"$input")"

deny() {
  jq -n --arg r "$1" '{hookSpecificOutput: {hookEventName: "PreToolUse",
    permissionDecision: "deny", permissionDecisionReason: $r}}'
  exit 0
}

case "$tool" in
  Bash)
    cmd="$(jq -r '.tool_input.command // ""' <<<"$input")"
    if grep -Eq -e '--no-verify|core\.hooksPath|GATE_EDIT|\.git/hooks|\.githooks' <<<"$cmd" ||
       grep -Eq -e 'git .*commit.* -[a-zA-Z]*n' <<<"$cmd"; then
      deny "The commit gate is not to be skipped or changed. Fix the code so ./checks.sh passes; if a scenario looks wrong, stop and say so."
    fi
    ;;
  Edit|Write|NotebookEdit)
    path="$(jq -r '.tool_input.file_path // .tool_input.notebook_path // ""' <<<"$input")"
    root="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}"
    rel="${path#"$root"/}"
    case "$rel" in
      checks.sh|scenarios/*|.githooks/*|.claude/settings.json|.claude/settings.local.json)
        deny "$rel belongs to the commit gate. Fix the code so ./checks.sh passes; if a scenario looks wrong, stop and say so."
        ;;
    esac
    ;;
esac
exit 0
